NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/resume-lab
CLIENT_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=your_jwt_access_secret_min_16_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_16_chars

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

OTP_SECRET=your_otp_secret_key_at_least_32_characters_long
OTP_EXPIRES_IN=10m

RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=ResumeLab <onboarding@resend.dev>

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AWS S3 Configuration (AWS SDK v3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=resumelab-storage
AWS_PRESIGNED_URL_EXPIRES_IN=3600
UPLOAD_MAX_SIZE_MB=200