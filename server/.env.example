NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/resume-lab
CLIENT_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=your_jwt_access_secret_min_16_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_16_chars

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

OTP_SECRET=your_otp_secret_key_at_least_32_characters_long
OTP_EXPIRES_IN=10m

RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=ResumeLab <onboarding@resend.dev>

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash